# Application
APP_NAME=Trade AI Agent
APP_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_ID=local
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
# Stable organization scope for the current single-organization deployment.
AGENT_ORG_ID=ba6e0000-0000-0000-0000-000000000001

# Database
DATABASE_URL=postgresql+pg8000://admin:password@localhost:5432/trade_ai

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
AGENT_RETRIEVAL_CACHE_ENABLED=true
AGENT_RETRIEVAL_CACHE_TTL_SECONDS=60
AGENT_CONCURRENCY_GLOBAL_LIMIT=32
AGENT_CONCURRENCY_ORG_LIMIT=16
AGENT_CONCURRENCY_USER_LIMIT=4
AGENT_CONCURRENCY_PROVIDER_LIMIT=16
AGENT_CONCURRENCY_TOOL_LIMIT=8
AGENT_CONCURRENCY_LEASE_SECONDS=300
AGENT_FAST_PATH_ENABLED=true
AGENT_FAST_PATH_MAX_INPUT_CHARS=240
AGENT_FAST_PATH_MAX_HISTORY_MESSAGES=6
AGENT_FAST_PATH_MAX_OUTPUT_TOKENS=800

# Fulfillment: quotations above the threshold or below the margin need a second admin approver
FULFILLMENT_QUOTE_APPROVAL_THRESHOLD=50000
FULFILLMENT_QUOTE_MIN_MARGIN_PERCENT=15
FULFILLMENT_QUOTE_EXPIRY_WARNING_DAYS=3

# Commerce assistants (commerce/). Empty values follow the AI runtime routing.
COMMERCE_ENABLED=true
COMMERCE_MODEL_PROVIDER=auto
COMMERCE_MODEL_NAME=
COMMERCE_MODEL_BASE_URL=
COMMERCE_MODEL_API_KEY=
COMMERCE_BRAND_NAME=B-agent Trade
COMMERCE_REPORTING_CURRENCY=USD
COMMERCE_BUYER_INVITE_DAYS=30

# Media asset plane (fail-closed by default)
MEDIA_UPLOAD_ENABLED=false
MEDIA_PLANNING_ENABLED=false
MEDIA_SUBMIT_ENABLED=false
MEDIA_SUBMIT_BATCH_SIZE=5
MEDIA_SUBMIT_LEASE_SECONDS=300
MEDIA_SUBMIT_POLL_SECONDS=10
MEDIA_JOB_DEADLINE_SECONDS=3600
MEDIA_T2V_RESERVATION_CEILING_MICROUSD=0
MEDIA_PROVIDER_INPUT_TTL_SECONDS=3600
MEDIA_INTENT_VAULT_DIR=./data/private/media-intents
MEDIA_INTENT_VAULT_KEY_FILE=./data/secrets/media-intent.key
MEDIA_RESULT_MAX_BYTES=1073741824
MEDIA_RESULT_DOWNLOAD_TIMEOUT_SECONDS=60
MEDIA_RECONCILE_BATCH_SIZE=10
MEDIA_RECONCILE_LEASE_SECONDS=300
MEDIA_RECONCILE_POLL_SECONDS=15
MEDIA_RECONCILE_RETRY_SECONDS=30
MEDIA_CALLBACK_ENABLED=false
MEDIA_CALLBACK_MAX_BODY_BYTES=262144
MEDIA_FAL_WEBHOOK_USER_ID=
MEDIA_FAL_WEBHOOK_URL=
MEDIA_FAL_JWKS_CACHE_SECONDS=3600
MEDIA_FAL_JWKS_TIMEOUT_SECONDS=5
MEDIA_INSPECTION_ENABLED=false
MEDIA_THUMBNAIL_ENABLED=false
MEDIA_LIFECYCLE_ENABLED=false
MEDIA_OBJECT_STORE_BACKEND=local
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_QUARANTINE_BUCKET=
MEDIA_S3_ASSET_BUCKET=
MEDIA_S3_KEY_PREFIX=
MEDIA_S3_KMS_KEY_ID=
MEDIA_CLAMSCAN_PATH=/usr/bin/clamscan
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_INSPECTION_TIMEOUT_SECONDS=30
MEDIA_INSPECTION_MAX_OUTPUT_BYTES=1048576
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_DIMENSION_PIXELS=8192
MEDIA_THUMBNAIL_TIMEOUT_SECONDS=60
MEDIA_THUMBNAIL_PROCESS_OUTPUT_BYTES=1048576
MEDIA_THUMBNAIL_MAX_BYTES=10485760
MEDIA_RETENTION_DAYS=30
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_MAINTENANCE_USER_ID=1
# One 0600 key file per immutable media runtime revision.
MEDIA_RUNTIME_SECRET_DIR=./data/secrets/media-runtime

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# AI Provider
AI_PROVIDER=tongyi
TONGYI_API_KEY=your-tongyi-api-key
TONGYI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-qwen-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# Internal LLM Gateway (keep direct until fixed aliases are provisioned)
LLM_BACKEND=direct
OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=
# Prefer a mounted secret file in production; it takes precedence in the factory.
OMNIROUTE_API_KEY_FILE=
AI_RUNTIME_SECRET_FILE=./data/secrets/omniroute_api_key
CONNECTOR_SECRET_DIR=./data/secrets/connectors
MAILBOX_SECRET_DIR=./data/secrets/mailboxes
# JSON list. Values must match OmniRoute's X-OmniRoute-Provider response header.
OMNIROUTE_ALLOWED_PROVIDERS=[]
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MODEL_LEAD_CLASSIFICATION=
OMNIROUTE_MODEL_MESSAGE_DRAFT=
OMNIROUTE_MODEL_LIVE_REPLY=
OMNIROUTE_MODEL_RAG_QUERY_REWRITE=
OMNIROUTE_MODEL_SUMMARIZATION=

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# Gmail API
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/mailboxes/oauth/callback/gmail

# Outlook API
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/v1/mailboxes/oauth/callback/outlook
OUTLOOK_TENANT_ID=common
FRONTEND_BASE_URL=http://localhost:3000

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# Data Service APIs
APIFY_API_KEY=your-apify-api-key
BRIGHT_DATA_API_KEY=your-bright-data-api-key
ZYTE_API_KEY=your-zyte-api-key

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=path/to/credentials.json

# Feishu
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# DingTalk
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting
EMAIL_RATE_LIMIT=100
WHATSAPP_RATE_LIMIT=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend development and runtime API routing
# Leave the base URL empty to use the same-origin Vite proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://backend:8000
VITE_HMR_HOST=
VITE_HMR_CLIENT_PORT=3000
VITE_USE_POLLING=true

# File Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
TEMPLATE_DIR=./app/templates

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
