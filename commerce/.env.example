# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.

# The model the example APIs call (examples/demo_common/model_provider.py). The default is
# anthropic, which reads ANTHROPIC_API_KEY. The others run over an OpenAI-compatible endpoint:
# openai, deepseek, qwen, moonshot, zhipu, ollama, or openai-compatible (any other endpoint;
# set MODEL_BASE_URL and MODEL_NAME).
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# The key for any other provider (each preset also reads its usual variable, such as
# DEEPSEEK_API_KEY or OPENAI_API_KEY).
MODEL_API_KEY=

# Optional overrides: the endpoint, the turn loop's model, and memory extraction's model.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_FAST_NAME=
